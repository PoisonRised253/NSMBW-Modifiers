# NOTE: "builddir" has special significance to Ninja (see the manual)
builddir = C$:\Users\PoisonDev\Desktop\PADV-NEXT\PropelParts\_build
outdir = C$:\Users\PoisonDev\Desktop\PADV-NEXT\PropelParts\bin

mwcceppc = F$:\WiiToolchain\cw\mwcceppc.exe
mwasmeppc = F$:\WiiToolchain\cw\mwasmeppc.exe
cc = "C$:\Users\PoisonDev\AppData\Local\Python\pythoncore-3.14-64\python.exe" "C$:\Users\PoisonDev\Desktop\PADV-NEXT\PropelParts\cw_wrapper.py" "$mwcceppc"
as = "C$:\Users\PoisonDev\AppData\Local\Python\pythoncore-3.14-64\python.exe" "C$:\Users\PoisonDev\Desktop\PADV-NEXT\PropelParts\cw_wrapper.py" "$mwasmeppc"
kamek = F$:\WiiToolchain\KamekBuild\Kamek.exe
kstdlib = F$:\WiiToolchain\KamekBuild\k_stdlib
addrmap = C$:\Users\PoisonDev\Desktop\PADV-NEXT\PropelParts\address-map.txt
externals = C$:\Users\PoisonDev\Desktop\PADV-NEXT\PropelParts\externals.txt
outmapsdir = C$:\Users\PoisonDev\Desktop\PADV-NEXT\PropelParts\_maps
includedir = C$:\Users\PoisonDev\Desktop\PADV-NEXT\PropelParts\include

shared_flags = $
  -I- $
  -i "$kstdlib" $
  -i "$includedir" $
  -maxerrors 1 $
  -proc gekko $
  -d REVOLUTION $
  -i include/propelparts/nsmbw-updated $
  -i include/lib $
  -i include/lib/MSL $
  -i include/lib/MSL/internal $
  -i include/lib/nw4r $
  -i include/lib/revolution/BTE/include $
  -i include/lib/revolution/BTE/stack/include $
  -i include/lib/revolution/BTE/stack/btm $
  -i include/lib/revolution/BTE/bta/include $
  -i include/lib/revolution/BTE/bta/sys $
  -i include/lib/revolution/BTE/gki/common $
  -i include/lib/revolution/BTE/gki/platform

cflags = $
  $shared_flags $
  -Cpp_exceptions off $
  -enum int $
  -O4,s $
  -use_lmw_stmw on $
  -fp hard $
  -rostr $
  -sdata 0 $
  -sdata2 0 $
  -RTTI off

asflags = $shared_flags

rule mkdir
  command = cmd /c mkdir $out
  description = mkdir -p $out

rule mwcc
  command = $cc $cflags -c -o $out -MDfile $out.d $in
  depfile = $out.d
  description = mwcceppc.exe -o $out_filename $in_filename

rule mwasm
  command = $as $asflags -c -o $out -MDfile $out.d $in
  depfile = $out.d
  description = mwasmeppc.exe -o $out_filename $in_filename

